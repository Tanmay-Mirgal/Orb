# ─────────────────────────────────────────────────────────────────────────────
# Orb — configuration. Copy to .env (never commit it). Every service reads the
# same file; real environment variables always take precedence.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Platform URLs ────────────────────────────────────────────────────────────
# BASE_DOMAIN: apps are served at <slug>.BASE_DOMAIN (needs a wildcard DNS record *.BASE_DOMAIN)
BASE_DOMAIN="localhost"
NEXT_PUBLIC_BASE_DOMAIN="localhost"
# Public URL of the dashboard
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Set false for plain-http local development (localhost)
PUBLIC_HTTPS="false"
# Port shown in preview URLs when BASE_DOMAIN=localhost (the edge proxy port)
PUBLIC_PORT="8000"

# Custom-domain DNS targets shown to users:
#   CNAME (subdomains) -> CNAME_TARGET   (default cname.<BASE_DOMAIN>, covered by your wildcard record)
#   A     (apex)       -> PLATFORM_IPS   (comma separated public IPs of your edge/Caddy nodes)
CNAME_TARGET=""
PLATFORM_IPS=""

# ── Database / cache ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://orb:password@localhost:5432/orb"
# Only for deploy/docker-compose.prod.yml: password of the bundled Postgres container (use hex: openssl rand -hex 24)
POSTGRES_PASSWORD=""
DATABASE_POOL_MAX="10"
# Set to false when using PgBouncer in transaction-pooling mode
DATABASE_PREPARE="true"
REDIS_HOST="localhost"
REDIS_PORT="6379"
# or a full URL (rediss:// for TLS). Takes precedence over HOST/PORT.
REDIS_URL=""
REDIS_PASSWORD=""

# ── Authentication (Better Auth + GitHub OAuth) ──────────────────────────────
BETTER_AUTH_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── GitHub App (push webhooks; optional private-repo access) ─────────────────
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_INSTALLATION_URL=""

# ── Secrets at rest ──────────────────────────────────────────────────────────
# AES-256-GCM key for environment variables (64 hex chars). To rotate: put the new key here and the
# old one in ENCRYPTION_KEY_PREVIOUS (comma separated), then run `npm run db:encrypt-legacy`-style re-save.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_PREVIOUS=""
# Shared by the control plane and runner nodes (runner -> /api/internal/*)
INTERNAL_API_TOKEN=""

# ── Object storage (static-site artifacts, archived build logs) ──────────────
# STORAGE_DRIVER=fs   local disk, development / single node ONLY
# STORAGE_DRIVER=s3   AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, Wasabi, Garage, SeaweedFS, ...
STORAGE_DRIVER="fs"
STORAGE_FS_ROOT="./.orb-data/storage"
S3_BUCKET=""
S3_REGION="auto"
# Leave empty for AWS S3. Example for R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""

# ── Container registry (images of web services / workers / cron jobs) ────────
# Required as soon as you run more than one runner node. Leave empty for a single node.
# Example: registry.example.com/orb
REGISTRY_URL=""
REGISTRY_USERNAME=""
REGISTRY_PASSWORD=""

# ── Build worker ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY="2"
WORKER_WORKDIR=""
MAX_SITE_MB="500"
MAX_SITE_FILES="20000"
DRAIN_DELAY_SECONDS="20"

# ── Runner node (one agent per machine that runs customer containers) ────────
NODE_ID=""
# Address the edge proxies use to reach containers on this node (private IP!)
RUNNER_ADDRESS="127.0.0.1"
# Interface container ports are published on. NEVER expose this publicly.
RUNNER_BIND_IP="127.0.0.1"
CONTROL_PLANE_URL="http://localhost:3000"
# Defaults: 80% of CPUs / 75% of RAM
RUNNER_CPU_MILLIS=""
RUNNER_MEMORY_MB=""

# ── Edge proxy ───────────────────────────────────────────────────────────────
PROXY_PORT="8000"
EDGE_RATE_LIMIT_RPS="200"
ROUTE_CACHE_TTL_SECONDS="30"
UPSTREAM_TIMEOUT_SECONDS="60"

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Private ports: /healthz /readyz /metrics (Prometheus)
WORKER_OPS_PORT="9101"
PROXY_OPS_PORT="9100"
RUNNER_OPS_PORT="9102"

# ── Caddy (TLS) — see Caddyfile ──────────────────────────────────────────────
ACME_EMAIL="admin@example.com"
DASHBOARD_HOST="orb.example.com"
# DNS-01 for the wildcard certificate (example: Cloudflare)
CLOUDFLARE_API_TOKEN=""

# ── Razorpay payments (plans & billing) ──────────────────────────────────────
# Dashboard → Account & Settings → API keys. Use rzp_test_… keys while testing; rzp_live_… charges real money.
# The key id is public (the checkout API hands it to the browser at runtime, no build arg needed).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks → <app url>/api/webhooks/razorpay with events payment.captured, order.paid, payment.failed.
# Without it, a buyer who closes the tab before the browser callback runs only gets their plan after a manual fix.
RAZORPAY_WEBHOOK_SECRET=""

# ── Outgoing e-mail: invitations, deploy/domain alerts, receipts ─────────────
# Plain nodemailer over SMTP, no cloud service needed. Simplest: a Gmail account with a Google "app password"
# (Google Account → Security → 2-Step Verification → App passwords). With a @gmail.com SMTP_USER the host is
# smtp.gmail.com and the sender is that same address, so only these two lines are required:
SMTP_USER=""
SMTP_PASSWORD=""
# Only for a non-Gmail SMTP server (Brevo, Zoho, your own mail server, ...):
SMTP_HOST=""
SMTP_PORT="587"
EMAIL_FROM=""
EMAIL_REPLY_TO=""
# With no SMTP_USER/SMTP_HOST, e-mails are logged instead of sent.

# ── Cost controls ────────────────────────────────────────────────────────────
# Minutes of no traffic before a Hobby web service is stopped; the edge wakes it on the next request.
# Empty = plan default (20), 0 = never sleep.
IDLE_SLEEP_MINUTES=""

# ── SEO (optional) ───────────────────────────────────────────────────────────
# Ownership tags for Google Search Console / Bing Webmaster (the "HTML tag" method). Not needed if you verify via DNS.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
