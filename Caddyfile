# Edge TLS termination for Orb (Caddy v2).
#
#   {$DASHBOARD_HOST}      the dashboard / API           (e.g. orb.example.com)
#   https://               projects & custom domains     — certificates issued on demand, gated by `ask`
#
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://{$WEB_UPSTREAM:localhost:3000}/api/internal/caddy/ask
	}
}

(hardening) {
	encode zstd gzip
	header -Server
}

{$DASHBOARD_HOST} {
	import hardening
	request_body {
		max_size 10MB
	}
	reverse_proxy {$WEB_UPSTREAM:localhost:3000}
}

# All deployed projects (*.BASE_DOMAIN) and custom domains:
# Certificates are issued automatically on-demand via HTTP challenge, gated by our API.
# Works with any DNS provider (Spaceship, Namecheap, GoDaddy, Cloudflare, etc.).
https:// {
	import hardening
	tls {
		on_demand
	}
	reverse_proxy {$PROXY_UPSTREAM:localhost:8000} {
		health_uri /__orb/health
		health_interval 10s
	}
}
